# Claude (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=

# Model used for Work Map generation, prediction grading and mastery reports
CLAUDE_MODEL=claude-opus-5-5
# Model used for live screen-frame analysis during capture (runs every few seconds)
CLAUDE_FAST_MODEL=claude-opus-5-5

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Supabase (Project Settings -> API Keys). Use the secret key, never the publishable one.
# Before first run, apply scripts/db.sql and scripts/migrations/*.sql in the SQL editor.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173
