# OpenRouter: every LLM call (capture, Work Map, tutor, apprentice). Free models only; server-side key.
# The model must accept images (capture sends screenshots) and support structured outputs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Supabase (Project Settings -> API Keys). Use the secret key, never the publishable one.
# Before first run, apply scripts/db.sql and scripts/migrations/*.sql in the SQL editor.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173
