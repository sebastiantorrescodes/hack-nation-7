# Shared model boundary: capture, Work Map, tutor and bounded apprentice.
# auto selects Gemini when GEMINI_API_KEY is set; otherwise it selects OpenRouter.
# Explicit gemini/openrouter values override auto. No automatic provider fallback.
LLM_PROVIDER=auto
# Use an AI Studio Free tier project with billing disabled for no-cost Gemini calls.
# The key itself cannot restrict requests to free billing; free content may be used
# to improve Google's products. Use synthetic records for free-tier demonstrations.
GEMINI_API_KEY=
# Flash-Lite passed the synthetic end-to-end build; 3.8 Flash remains an option.
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenRouter alternative: zero-price routing, :free models only; server-side key.
# The model must accept images (capture sends screenshots) and support structured outputs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# ElevenLabs Conversational AI
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Supabase (Project Settings -> API Keys). Use the secret key, never the publishable one.
# Before first run, apply scripts/db.sql and scripts/migrations/*.sql in the SQL editor.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Local mode accepts loopback requests only. Use authenticated mode for any public URL.
APP_AUTH_MODE=local
# With APP_AUTH_MODE=supabase, supply the publishable/anon key (never the service key).
SUPABASE_PUBLIC_KEY=
