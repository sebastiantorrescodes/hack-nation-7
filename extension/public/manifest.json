{
  "manifest_version": 3,
  "name": "AI Apprentice",
  "version": "0.1.0",
  "description": "Captures an expert's know-how while they work in any web app, and tutors newcomers on it.",
  "action": { "default_title": "Open AI Apprentice" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["sidePanel", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
